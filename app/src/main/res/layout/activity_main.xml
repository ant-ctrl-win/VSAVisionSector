<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F11">

    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/cardResults" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabLearn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/cardResults"
        android:layout_alignParentEnd="true"
        android:layout_margin="20dp"
        android:contentDescription="Impara Oggetto"
        android:backgroundTint="#2E7D32"
        app:tint="#FFFFFF"
        app:srcCompat="@android:drawable/ic_input_add"
        app:fabSize="normal" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#E61E1E24"> <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvVerdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inizializzazione VSA..."
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pronto per l'analisi offline"
            android:textSize="14sp"
            android:textColor="#A0A0AB"
            android:gravity="center"
            android:textStyle="italic"/>

        <ProgressBar
            android:id="@+id/progressLearning"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:progressTint="#2E7D32"
            android:progressBackgroundTint="#3A3A44" />
    </LinearLayout>
    </androidx.cardview.widget.CardView>

    <com.antonio.visionsector.ui.TrackingOverlayView
        android:id="@+id/trackingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</RelativeLayout>
